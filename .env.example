# ---------------------------------------------------------------------------
# Scoring service (services/scorer)
# ---------------------------------------------------------------------------
# "heuristic" runs with no model download and no torch. Good enough to develop
# the whole pipeline against. "transformer" is what you ship.
SCORER_BACKEND=transformer
# Force CPU even when CUDA or MPS is available. Set true on a plain VPS so
# torch does not probe for accelerators that are not there.
SCORER_FORCE_CPU=false
SCORER_MODEL=distilgpt2
SCORER_PORT=8000
# Verdict thresholds on the 0-100 output. The band between them reads as
# "mixed", and it is deliberately wide: short factual prose scores high on
# every detector, so a narrow band would label ordinary news copy as machine
# written.
SCORER_HUMAN_CEILING=35
SCORER_AI_FLOOR=70

# ---------------------------------------------------------------------------
# Gateway (apps/api)
# ---------------------------------------------------------------------------
API_PORT=4000
SCORER_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:3000

# Anonymous tier limits. There is no login in v1, so these are the only
# thing standing between you and someone scripting your LLM budget away.
MAX_WORDS=1500
RATE_LIMIT_PER_HOUR=20
RATE_LIMIT_BURST=5

# Leave unset to use an in-process store. Fine for one instance, wrong for two.
# REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# LLM provider: anthropic | ollama | groq | gemini | echo
# ---------------------------------------------------------------------------
# "echo" returns the input untouched, so the deterministic pass and the scoring
# loop still run. Use it to work on the pipeline with zero provider setup.
LLM_PROVIDER=anthropic

# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Thinking depth and the main cost dial short of changing model. Paraphrase is
# not a hard reasoning task, so "low" is the right default. low|medium|high|xhigh|max
ANTHROPIC_EFFORT=low
# Thinking during drafting: adaptive | disabled.
# 'disabled' roughly halves the bill. It was the default for one round, on the
# basis that quality held. That was checked against the LOCAL scorer, which has
# since been shown not to track real detectors, so the claim was unsupported.
# Back to 'adaptive' until it is measured against the detector you are judged by.
ANTHROPIC_THINKING=adaptive
# The fidelity judge. Pinned to Sonnet 5 as well, so no other model is
# ever reached. A cheaper judge would cut the humanize bill, but this
# keeps the deployment to a single model as requested.
ANTHROPIC_JUDGE_MODEL=claude-sonnet-5

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# External AI detectors
# ---------------------------------------------------------------------------
# THIS IS THE SETTING THAT MATTERS if you are checking results against a
# commercial detector. The local scorer is a proxy: beating it says nothing
# about what GPTZero or Originality will report.
#
# DETECTOR_PRIMARY drives the humanize loop. Set it to the detector you are
# actually judged by. It is called once per rewrite pass, so up to three times
# per request.
DETECTOR_PRIMARY=local

# DETECTOR_VERIFY is a comma-separated second opinion, run exactly twice per
# request: once on your input, once on the final output. Use it to see whether
# the rewrite moved the numbers you care about.
# DETECTOR_VERIFY=gptzero,originality,zerogpt

# GPTZERO_API_KEY=
# ORIGINALITY_API_KEY=
# ZEROGPT_API_KEY=
# ZeroGPT ships several APIs across several domains with different paths and
# field names. Override the endpoint here if the default does not match your plan.
# ZEROGPT_URL=https://api.zerogpt.com/api/detect/detectText

# ---------------------------------------------------------------------------
# Humanize loop
# ---------------------------------------------------------------------------
# Stop rewriting once the score drops to or below this. A high value here is
# the most common reason output lands around 20: the loop declares victory the
# moment it clears the bar and stops trying. Benchmarked across four styles,
# nothing reached 3 even in four passes, so the practical floor on the local
# scorer is around 10.
# Loop target, on the RAW internal scale. The calibration maps this onto a
# commercial detector: raw 3.2 is roughly ZeroGPT 10, raw 5.5 roughly 30.
# Measured best so far is raw 6.2, so a target of 3 is aspirational and the
# loop will spend its full pass budget trying to reach it.
# Hard ceiling on model spend per article, in USD.
# $0.10 x 1,000 articles = $100. Enforced twice: passes are planned down to
# fit before anything is spent, and the rewrite loop stops between passes
# rather than crossing the line.
MAX_COST_PER_ARTICLE=0.10

TARGET_SCORE=3.5
# Hard cap on rewrite passes. Each pass is a full LLM call per chunk.
MAX_ITERATIONS=4
# Fidelity guard, three layers. Hard constraints on numbers, protected spans
# and length always run and are free. Below are the two tunable layers.
#
# Floor for the topical screen, which catches a rewrite that is about a
# different subject. Kept low on purpose: it is a screen, not a verdict. A
# good paraphrase legitimately scores 0.23-0.44, so a high floor rejects
# everything the pipeline is meant to produce.
MIN_TOPICAL_SIMILARITY=0.1
# The semantic judge: one small model call asking whether the rewrite still
# asserts the same things. The only layer that catches a fluent rewrite that
# reverses a claim. Set false to save roughly one cheap call per pass.
FIDELITY_JUDGE=true
# THE MAIN COST/QUALITY DIAL, and it runs the opposite way to intuition.
# Smaller chunks mean more model calls and a much lower detection score,
# because rewriting fifty words forces every sentence to be reworked while
# rewriting three hundred gets a lighter touch spread thinner.
#
# Measured, one 2,570-word article, four passes on Opus:
#    50 words per chunk  ->  $2.06  ZeroGPT ~7
#   330 words per chunk  ->  $0.90  ZeroGPT ~22
#
# Lower it to buy score. Raise it to buy budget.
CHUNK_WORDS=60
# Fraction of chunks a follow-up pass rewrites, worst-scoring first. Pass one
# always rewrites the whole article; later passes refine the accepted text and
# only spend on the chunks the scorer rates worst. Set to 1 to rewrite
# everything on every pass.
TARGET_SHARE=0.34
# Raw detection points a failing readability check is worth in the loop's
# objective. Keep it small. Raw document scores move inside a band of about
# four points, so a large value here lets readability overrule detection
# entirely, which is the opposite of what this tool is for.
READABILITY_WEIGHT=0.5
# Humanize each section as it is drafted, instead of the whole article
# afterwards. Measured against the document loop on the same brief: slightly
# cheaper and slightly worse. Burstiness is a property of the assembled
# article and cannot be optimised inside a 200-word section.
INLINE_HUMANIZE=false

# ---------------------------------------------------------------------------
# Web (apps/web)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Batch API
# ---------------------------------------------------------------------------
# Anthropic's Message Batches API bills at half rate. The cost is latency:
# Anthropic commits to 24 hours and usually returns in minutes, and nothing
# you do speeds it up.
#
# Batching only helps calls that do not depend on each other, and inside ONE
# article almost nothing qualifies. The outline feeds the sections, each
# section is handed the tail of the one before, the judge cannot read a
# rewrite that does not exist. The only independent set is the chunk rewrites
# of a humanize pass.
#
# Measured on one 2,000-word article:
#   not batched                        $0.193
#   chunk rewrites batched             $0.169   (12% saved)
#
# USE_BATCH_API turns on that per-article batching for ordinary /draft calls.
# Off by default: someone waiting on one article in the browser should not be
# handed an unbounded wait to save two cents.
USE_BATCH_API=false
# How long to wait for one batch before cancelling it.
BATCH_MAX_WAIT_MS=2700000
#
# The bulk path is where batching actually pays. Across articles nearly every
# call is independent, so /api/generate/bulk runs many articles at once and
# pools whatever they are asking for into shared batches. Every phase batches,
# not just the rewrites, which is roughly half of $0.193 and what brings 1,000
# articles inside $100.
#
# Articles running at once. This IS the batch size for most phases, because
# each article can only offer one call at a time through most of its life.
# Too low and every batch is tiny: full price plus minutes of waiting.
BULK_CONCURRENCY=25
# Flush a partial batch once this many requests are waiting. Mostly an upper
# bound: the queue also flushes the moment every article in flight is parked,
# which is the common case.
BATCH_QUEUE_SIZE=400
# Safety net for the ragged end of a job, when a few stragglers remain.
BATCH_QUEUE_WAIT_MS=20000
# Refuse jobs larger than this. A thousand articles is around $100.
BULK_MAX_JOB_SIZE=1000
# Where job records and finished articles are written.
BULK_STATE_DIR=.bulk
#
# WALL CLOCK. Elapsed time for a bulk job is set by the number of SEQUENTIAL
# phases, not the number of articles: one round for outlines, one per section,
# one for metadata, one for the rewrite wave, one for the judge. Each round is
# one batch and a batch takes minutes. So a thousand articles finish in about
# the same elapsed time as eight, and only the thousand makes that time worth
# paying. Below roughly eight articles, use the ordinary draft endpoint.

# ---------------------------------------------------------------------------
# Password and the saved library
# ---------------------------------------------------------------------------
# OPTIONAL, and off by default. Leave ACCESS_PASSWORD blank or commented out
# and the whole app is open with no password prompt at all, which is the right
# setup on your own machine.
#
# Set it and every route except /api/config asks for it once, and the browser
# remembers it. It is ONE password shared by the whole team, not a login:
# nothing records who saved or deleted an article, and changing it for one
# person changes it for everybody. That suits an internal tool on a network
# you control and does not suit anything on the public internet.
#
# Not to be confused with ANTHROPIC_API_KEY and the detector keys above. Those
# are machine credentials this app sends out to vendors; this is a word a
# person types in.
#
# Worth setting the moment anyone else can reach the port, because the library
# below stores real work on disk and an open port is an open filing cabinet.
# The server logs which mode it is in at startup, since a protected server and
# an open one look identical from the outside.
#
# ACCESS_PASSWORD=
#
# Where saved brands and their articles are written. One directory per brand,
# a full article plus a small metadata file per article. The metadata split is
# what keeps a brand with a thousand articles listing instantly instead of
# reading a hundred megabytes of JSON.
LIBRARY_DIR=.data
